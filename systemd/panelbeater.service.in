[Unit]
Description=ScanSnap panel scanning (keeps the touch panel enabled)
Documentation=https://github.com/CHANGEME/panelbeater
# The scanner is on the network, so do not start before it can be reached.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@BIN@ serve
# The panel goes dead within about a minute of nobody being registered, so a
# crashed daemon means a scanner nobody can use. Always come back.
Restart=always
RestartSec=10
# Journal only; the daemon prints one line per scan and nothing per
# registration.
StandardOutput=journal
StandardError=journal

# Everything machine-specific belongs in the config file, not here. Any setting
# can still be forced with an override if you want to, for example:
#   systemctl --user edit panelbeater
#   [Service]
#   Environment=PANELBEATER_OUTPUT_DIR=%h/Documents/Inbox

[Install]
WantedBy=default.target
